# 環境変数の見本。これを .env に写して、値を変えて使う（.env は Git の対象外。Claude は読まない）。
#   PowerShell：Copy-Item env.example .env
#   Git Bash  ：cp env.example .env
# 本物の値をこのファイルに書かない。

# ---- DB（docker compose の PostgreSQL） ----
POSTGRES_DB=ecu_sec
POSTGRES_USER=ecu_sec_app
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ---- API・Alembic・ダミーデータ（backend/app/config.py が上の3つから接続先を組み立てる） ----
# DB の場所。省略すると手元の docker compose の DB（127.0.0.1:5432）
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# ---- 認証（JWT の署名の鍵。必須。32バイト以上の乱数にする） ----
# 作り方（どちらか）：
#   PowerShell：[Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
#   Git Bash  ：openssl rand -base64 48
JWT_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-bytes
# トークンの有効期限（分）。省略すると 30
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- ダミーデータの利用者のパスワード（全員共通。練習用） ----
# 空なら全員ログインできない。入れたあと、すでにデータがある DB には
#   cd backend && uv run python -m app.seed --set-passwords
# で入れ直す（docker compose の中なら docker compose exec api python -m app.seed --set-passwords）
SEED_USER_PASSWORD=
